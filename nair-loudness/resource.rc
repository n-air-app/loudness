            VALUE "ProductName", NAME "\0"
            VALUE "FileVersion", VERSION "\0"
            VALUE "ProductVersion", VERSION "\0"
            VALUE "Comments", "Built for obs-studio-node " TARGET_OBS_STUDIO_NODE_VERSION " / " TARGET_LIBOBS_VERSION "\0"
            VALUE "LibOBSVersion", TARGET_LIBOBS_VERSION "\0"
            VALUE "OBSStudioNodeVersion", TARGET_OBS_STUDIO_NODE_VERSION "\0"
